{
  /*** Global Configuration ***/
  "global": {
    "config_path": "",
    "config_ros": "config_ros.json",
    "config_logging": "config_logging.json",
    "config_viewer": "config_viewer.json",
    "config_sensors": "config_sensors.json",
    // P4#2 — DENSE LOCALIZATION-MAP profile is the ACTIVE DEFAULT (upgraded
    // from opt-in after review): every map this pipeline builds is consumed
    // by gicp_localization, so the dense variants (preprocess 0.4 m / 80k,
    // submap voxel 0.25 m / 150k) are the production choice. The run-12/13
    // cross-run GICP fitness floor (~0.27) is dominated by map sparsity from
    // the old 1.0 m preprocess downsample. Fall back to the legacy sparse
    // configs (commented) only for odometry-only smoke runs or if mapping
    // CPU/memory becomes a problem. After the first dense-map rebuild,
    // re-baseline the GICP fitness floor with
    // the selected localizer's scan diagnostics — the P1 ratio
    // thresholds depend on it.
    "config_preprocess": "config_preprocess_dense_map.json",
    // "config_preprocess": "config_preprocess.json",  // legacy sparse (odometry-only runs)
    // RTK-tolerant mapping design:
    //   * Primary odometry = LiDAR + IMU fused (gpu/cpu/ct estimator). Runs
    //     continuously, no external pose required, no holes during RTK loss.
    //   * Global anchoring = libgnss_global.so extension (enabled in
    //     config_ros.json), which adds GNSS-position factors to the iSAM2
    //     graph whenever a usable RTK-FIXED sample arrives. During GNSS-denied
    //     passages the GNSS factor stream goes silent and LiDAR+IMU odometry
    //     alone drives the trajectory until RTK reacquires.
    //   * Pre-filter (an external covariance-qualified odometry source (historical profile))
    //     gates the GNSS topic to RTK-FIXED quality only, so degraded fixes
    //     never poison the global graph.
    // The old config_odometry_ins.json path (INS-driven, GLIM PAUSES on RTK
    // loss) is left in tree for reference but should not be selected for
    // production mapping that traverses GNSS-denied terrain.
    "config_odometry": "config_odometry_gpu.json",
    // "config_odometry": "config_odometry_ins.json",
    // "config_odometry": "config_odometry_cpu.json",
    "config_sub_mapping": "config_sub_mapping_dense_map.json",
    // "config_sub_mapping": "config_sub_mapping_passthrough.json",  // legacy sparse (odometry-only runs)
    "config_global_mapping": "config_global_mapping_gpu.json",
    "config_pcap": "config_pcap.json"
  }
}